# ── Model weights ────────────────────────────────────────────────────────────
# 19 GB of safetensors / LoRA adapters.  Re-download with envs/predownload_models.sh
hf_models/

# ── Python virtual environments & installed-package dirs ─────────────────────
# envs/grader/ and envs/vllm/ are full venvs (~8 GB).
# The setup scripts (build_vllm_env.sh, predownload_models.sh) live one level up
# and ARE committed.
envs/grader/
envs/vllm/
# `pip install --target` overlays on top of envs/vllm (fla, scikit-learn, ...).
envs/*_overlay/
# Per-team venvs (team3 envs/client).
evals/rl_evals/*/envs/
# pylibs/ dirs created with `pip install --target pylibs/` — installed packages,
# not source code.  Recreate by re-running the team's install step.
**/pylibs/

# ── Python bytecode ───────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── SLURM / job logs ──────────────────────────────────────────────────────────
# Runtime output files produced by sbatch / srun jobs.
logs/
*.out
evals/subliminal/logs/

# ── Generated eval data ───────────────────────────────────────────────────────
# Dataset files and generated prompts (re-creatable; 39 MB).
evals/subliminal/data/

# ── Subliminal-learning workstream: raw artefacts (77 GB) ────────────────────
# Trajectories, judge outputs, filtered SFT sets, LoRA adapters, trainer
# checkpoints and per-item student scores stay on /data.  Only the small
# summaries are committed: *.md reports, *.json summaries/manifests/configs,
# *.png histograms, train_log.jsonl, the hand labels used for judge agreement,
# and the teacher-id classifier scores.  Regenerate the rest with code/*.sbatch.
evals/subliminal/results/**
!evals/subliminal/results/**/
!evals/subliminal/results/**/*.md
!evals/subliminal/results/**/*.json
!evals/subliminal/results/**/*.png
!evals/subliminal/results/**/train_log.jsonl
!evals/subliminal/results/judge_agreement/*.jsonl
!evals/subliminal/results/cand*/teacher_id/**/*.jsonl
# ...but never the adapters, trainer checkpoints, tokenizers, viewers, or
# archived / superseded runs.
evals/subliminal/results/**/adapter/
evals/subliminal/results/**/adapter_vllm/
evals/subliminal/results/**/checkpoint-*/
evals/subliminal/results/**/tokenizer.json
evals/subliminal/results/students_viewer/
evals/subliminal/results/**/_v1_backup/
evals/subliminal/results/**/*_archive/
evals/subliminal/results/**/*_snapshot/
evals/subliminal/results/**/*dryrun*
evals/subliminal/results/**/.merge.lock


# ── Generated review page (make_review.py inlines the PNGs into the src html)
evals/figures/figures_review.html

# ── Vendored author repos (pinned) ────────────────────────────────────────────
# The authors' eval repos are NOT committed; they are re-cloned at exact commits
# by `evals/rl_evals/setup_external.sh` (pins in `evals/rl_evals/external.lock`).  ~180 MB, plus
# their own nested .git dirs.  Keeps our repo lean and avoids embedded-repo warnings.
evals/rl_evals/*/external/

# ── Claude transcript exports ─────────────────────────────────────────────────
claude-transcript-**/

# ── Misc ──────────────────────────────────────────────────────────────────────
.DS_Store
*.swp
*.swo

# ── Transfer stage (2026-09-11): raw trajectories and 5k-row student datasets stay on /data; reports and figures are committed
evals/trajectory_generation/results/**/*.jsonl
evals/filtering/results/**/*.jsonl
evals/student_sft/results/**/adapter/
evals/student_sft/results/**/adapter_vllm/
evals/student_sft/results/**/checkpoint-*/
evals/sft_evals/results/hacks/
evals/sft_evals/results/teachers/**/train/checkpoint-*/
evals/sft_evals/results/teachers/**/adapter_vllm/
evals/sft_evals/results/teachers/**/adapter/
